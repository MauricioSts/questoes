// Prisma schema: banco de questões.
// Regra central: o backend NUNCA guarda enunciado/alternativas/gabarito. Só o resultado
// da resposta com snapshots de modulo/materia/assunto/dificuldade, o que permite gerar
// estatística e priorizar erradas sem depender do JSON de questões.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Contexto {
  ESTUDO
  FLASH
  SIMULADO
  TOPICO
  BATALHA
}

// Banco de questões (conteúdo). Compartilhado entre usuários (não é escopo por userId).
// A correção de acerto continua no frontend; o backend só guarda e serve o conteúdo.
model Questao {
  id               Int             @id // ID definido no lote (usado como questaoId em Answer)
  concursoId       String? // concurso ao qual a questão pertence (multi-concurso). null = legado
  modulo           String // "I" | "II"
  materia          String
  assunto          String
  dificuldade      String // facil | media | dificil
  textoBaseKey     String? // chave em TextoBase (questões de inglês)
  enunciado        String
  codigo           String? // bloco de código opcional
  linguagem        String? // rótulo da linguagem do código
  alternativas     Json // { "A": "...", "B": "...", ... }
  gabarito         String
  explicacao       String
  // Figuras da questão: [{ arquivo, legenda, posicao, dados }], com a imagem embutida
  // como data URI em `dados`. null/ausente na maioria das questões.
  imagens          Json?
  // Trilha dona do conteúdo: é por ela que as questões chegam a QUALQUER usuário que
  // siga a trilha. null = questão importada direto num concurso, visível só nele.
  trilhaId         String?
  trilha           Trilha?         @relation(fields: [trilhaId], references: [id], onDelete: SetNull)
  loteNome         String? // rótulo do lote (nome do arquivo importado); null p/ imports antigos
  // Procedência da questão: "oficial" (texto igual ao da prova), "adaptada" (baseada numa
  // prova, com texto alterado), "gerada" (criada como reforço a partir dos meus erros) ou
  // "autoral" (escrita sem prova de referência). Legado importado antes disso = "autoral".
  origem           String          @default("autoral")
  provaChave       String? // prova de onde veio (oficial/adaptada); null nas demais origens
  prova            Prova?          @relation("QuestaoOrigem", fields: [provaChave], references: [chave], onDelete: SetNull)
  // Prova de que o LOTE foi montado. Vale para todas as questões dele, inclusive as
  // autorais escritas junto — por isso é separada de provaChave, que afirma que o texto
  // saiu da prova. Estatística por prova usa provaChave; "de que lote veio" usa esta.
  provaBaseChave   String?
  provaBase        Prova?          @relation("QuestaoLoteBase", fields: [provaBaseChave], references: [chave], onDelete: SetNull)
  numeroOriginal   Int? // número que a questão tinha na prova de origem
  // Reforço: IDs das questões erradas que motivaram a geração desta. [] / null nas demais.
  geradaDe         Json?
  // conceitual = pergunta comum (com ou sem código ilustrativo); saida = "qual a saída deste
  // código"; erro = "qual o erro deste código". As duas últimas só entram no banco com a
  // execução no sandbox que confirmou o gabarito (execucaoId).
  tipo             String          @default("conceitual")
  execucaoId       String?
  execucao         Execucao?       @relation(fields: [execucaoId], references: [id], onDelete: SetNull)
  // Trilhas além da dona (trilhaId) em que a questão também aparece, sem duplicar a linha.
  vinculos         QuestaoTrilha[]
  // MULTIPLA_ESCOLHA (A–E) ou CERTO_ERRADO (estilo Cebraspe). No certo/errado cada item é
  // uma questão própria: enunciado = afirmação, alternativas fixas { C: "Certo", E: "Errado" }
  // e gabarito "C"|"E". Assim resposta, revisão, caderno e estatística valem sem mudança.
  formato          String          @default("MULTIPLA_ESCOLHA")
  // Comando (texto-base / "julgue os itens") que agrupa os itens certo/errado.
  comandoId        String?
  comando          Comando?        @relation(fields: [comandoId], references: [id], onDelete: SetNull)
  // Gabarito duvidoso: a correção mostra "gabarito a conferir" até alguém confirmar.
  gabaritoConferir Boolean         @default(false)
  createdAt        DateTime        @default(now()) // idêntico p/ toda questão de um mesmo import → chave do lote

  @@index([modulo, materia])
  @@index([createdAt])
  @@index([concursoId])
  @@index([origem])
  @@index([provaChave])
  @@index([provaBaseChave])
  @@index([trilhaId])
  @@index([comandoId])
}

// Comando de uma prova certo/errado: o texto que vem antes dos itens ("Considerando…,
// julgue os itens a seguir"), com o código compartilhado por eles quando há.
model Comando {
  id         String    @id @default(cuid())
  trilhaId   String?
  trilha     Trilha?   @relation(fields: [trilhaId], references: [id], onDelete: SetNull)
  loteNome   String?
  numero     Int // id do comando dentro do lote (1, 2, 3…)
  grupo      String // grupo do perfil de prova: "P1", "P2", "P3"
  disciplina String
  texto      String
  codigo     String?
  linguagem  String?
  imagens    Json?
  createdAt  DateTime  @default(now())
  questoes   Questao[]

  @@index([trilhaId])
}

// Perfil de pontuação de uma prova (grupos, disciplinas, pesos, mínimos, tempo), no formato
// de docs/perfis/*.json. É o que valida a disciplina de um lote certo/errado e calcula a nota.
model PerfilProva {
  id        String   @id // "cgu-2026-dev"
  nome      String
  dados     Json
  createdAt DateTime @default(now())
  trilhas   Trilha[]
}

// Resultado de um simulado certo/errado. Fica numa tabela própria porque o item deixado em
// branco não grava Answer, e sem ele não dá para refazer a nota (branco ≠ erro). Os itens
// marcados também viram Answer (contexto SIMULADO), como no simulado de múltipla escolha.
model ResultadoProva {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concursoId    String
  perfilProvaId String
  // { grupos: [{ grupo, acertos, erros, brancos, pontos, minimo, ... }], total, aprovado,
  //   motivos, itens: [{ questaoId, marcada|null }], duracaoSegundos }
  dados         Json
  createdAt     DateTime @default(now())

  @@index([userId, concursoId, createdAt])
}

// Trilha de estudo: um conjunto de questões que vários usuários podem seguir. É o que
// o usuário escolhe ao entrar no app. Existe porque Questao.concursoId aponta para o
// Concurso de UM usuário: sem a trilha, quem cria o próprio concurso começa com o banco
// vazio. A trilha é o dono compartilhado do conteúdo; o Concurso continua sendo a cópia
// pessoal (progresso, meta, caderno) de cada um que a segue.
model Trilha {
  id            String       @id // slug, ex.: "dataprev-analista-ti"
  nome          String // "Dataprev"
  cargo         String // "Analista de TI"
  iniciais      String // "DTPV" (selo do cartão)
  banca         String
  orgao         String
  ano           Int
  descricao     String // parágrafo do cartão de escolha
  dataProva     DateTime? // usada como data inicial do concurso de quem entra
  publicada     Boolean      @default(true) // false = não aparece na escolha
  ordem         Int          @default(0)
  // Trilha da comunidade: quem criou. null = trilha oficial (do admin). Se o dono apagar
  // a conta, a trilha fica (quem segue não perde o acervo), só ninguém mais a edita.
  donoId        String?
  dono          User?        @relation(fields: [donoId], references: [id], onDelete: SetNull)
  // "publica" aparece na escolha de trilhas; "privada" só para o dono (recurso Premium).
  visibilidade  String       @default("publica")
  // concurso | escola | vestibular | outro: só muda rótulos e o selo; o resto é igual.
  tipo          String       @default("concurso")
  // Perfil da prova certo/errado que esta trilha segue (nota por grupo, mínimos, tempo).
  perfilProvaId String?
  perfilProva   PerfilProva? @relation(fields: [perfilProvaId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  questoes   Questao[]
  comandos   Comando[]
  concursos  Concurso[]
  vinculos   QuestaoTrilha[]
  exercicios Exercicio[]

  @@index([publicada, ordem])
  @@index([donoId])
}

// Prova de concurso de onde uma ou mais questões vieram. Vive fora da Questao porque
// dezenas de questões compartilham a mesma prova (mesmo padrão de TextoBase).
model Prova {
  chave         String    @id // ex.: "FGV_TCE-TO_2022_ANALISTA-TI"
  banca         String
  orgao         String
  ano           Int
  cargo         String? // cargo/perfil da prova
  tipo          String? // caderno, quando a banca embaralha versões (FGV: "1", "2", "3")
  url           String? // PDF oficial
  // "definitivo" = gabarito definitivo da banca; "resolucao_propria" = resolvido por quem
  // montou o lote (a correção mostra "gabarito não oficial"). null = lotes antigos.
  gabaritoFonte String?
  createdAt     DateTime  @default(now())
  questoes      Questao[] @relation("QuestaoOrigem")
  lotes         Questao[] @relation("QuestaoLoteBase") // questões de lotes montados a partir dela

  @@index([banca, ano])
}

// Concurso do usuário. O app é multi-concurso: cada concurso tem seu próprio conjunto de
// questões, respostas, anotações e caderno. Nenhum dado atravessa concursos.
model Concurso {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome           String // "Banco do Brasil"
  iniciais       String // "BB"
  banca          String // "CESGRANRIO"
  ano            Int
  cargo          String
  dataProva      DateTime
  metaDiaria     Int       @default(30)
  // Trilha que este concurso segue. Define o banco de questões que o usuário enxerga.
  trilhaId       String?
  trilha         Trilha?   @relation(fields: [trilhaId], references: [id], onDelete: SetNull)
  arquivado      Boolean   @default(false)
  // Marco de reinício da revisão espaçada: respostas anteriores a esta data não contam
  // no agendamento do SRS (a fila volta a zero sem apagar nenhuma resposta, então
  // estatística, ofensiva e histórico de erros continuam intactos).
  srsResetAt     DateTime?
  // Simulado configurado pelo usuário (composição, pesos, duração, corte, dia). null =
  // padrão calculado no cliente a partir das matérias da trilha.
  simuladoConfig Json?
  // Modo férias DESTE concurso (a ofensiva é por trilha). User.feriasAtivo é legado.
  feriasAtivo    Boolean   @default(false)
  createdAt      DateTime  @default(now())

  paginas PaginaCaderno[]
  postits PostIt[]

  @@index([userId])
  @@index([trilhaId])
}

// Página do Caderno (anotações tipo Notion), escopada por usuário + concurso + matéria.
model PaginaCaderno {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concursoId String
  concurso   Concurso @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  materia    String
  titulo     String   @default("")
  conteudo   String   @default("") // HTML saneado quando formato = "html"
  // "html" = conteúdo do editor rico; "texto" = páginas antigas, salvas como texto puro
  // (o cliente converte para parágrafos ao abrir e regrava já como html).
  formato    String   @default("html")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, concursoId])
}

// Post-it do mural (Home), arrastável, escopado por usuário + concurso.
model PostIt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concursoId String
  concurso   Concurso @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  x          Float    @default(0)
  y          Float    @default(0)
  texto      String   @default("")
  cor        String   @default("amber") // amber | sage | rose | slate
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, concursoId])
}

model TextoBase {
  chave String @id
  texto String
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  nome               String
  metaDiaria         Int       @default(70) // meta diária de questões (configurável no futuro)
  dataProva          DateTime? // data alvo da prova (configurável pelo usuário)
  feriasAtivo        Boolean   @default(false) // modo férias ligado: dias não quebram a ofensiva
  feriasDesde        DateTime? // instante em que o modo férias foi ligado (janela atual/última)
  feriasAte          DateTime? // instante em que foi desligado (null enquanto ativo)
  srsResetAt         DateTime? // reinício do SRS fora de concurso (ver Concurso.srsResetAt)
  pokeResetAt        DateTime? // Batalha Pokémon: perfil do aparelho criado antes disso é descartado
  // Conta criada pelo /auth/register nasce false e só loga depois que o admin aprova
  // pelo link do e-mail. O default true mantém as contas antigas liberadas.
  aprovado           Boolean   @default(true)
  aprovacaoTokenHash String?   @unique // sha256 do token do link de aprovação
  // Acesso completo sem pagar: contas que já existiam antes da assinatura, e quem o
  // admin quiser liberar à mão. O admin (ADMIN_EMAIL) tem acesso completo sem isto.
  cortesia           Boolean   @default(false)
  // Verificação em duas etapas: com isto ligado, o login só emite tokens depois do
  // código de 6 dígitos mandado para o e-mail da conta (ver CodigoEmail).
  doisFatores        Boolean   @default(false)
  // E-mail confirmado por código (CodigoEmail finalidade "ativar"). Ligar as duas etapas
  // também confirma, porque passa pelo mesmo código.
  emailVerificado    Boolean   @default(false)
  createdAt          DateTime  @default(now())

  answers         Answer[]
  notas           Nota[]
  marcadas        Marcada[]
  concursos       Concurso[]
  paginas         PaginaCaderno[]
  postits         PostIt[]
  feriasPeriodos  FeriasPeriodo[]
  refreshTokens   RefreshToken[]
  sessaoAtiva     SessaoAtiva?
  metasMateria    MetaMateriaDia[]
  pokeVitrine     PokeVitrine?
  pokeSave        PokeSave?
  pokeSaveTrilhas PokeSaveTrilha[]
  assinatura      Assinatura?
  trilhas         Trilha[]
  importacoesPdf  ImportacaoPdf[]
  codigosEmail    CodigoEmail[]
  execucoes       Execucao[]
  resultadosProva ResultadoProva[]
}

// Assinatura do Mercado Pago (API de preapproval): uma linha por usuário, apontando para
// a assinatura mais recente dele. O estado vem sempre de uma consulta ao Mercado Pago
// (lib/assinatura.ts), nunca do corpo do webhook nem do cliente.
model Assinatura {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plano           String // mensal | anual
  mpPreapprovalId String    @unique
  status          String // pending | authorized | paused | cancelled (status do Mercado Pago)
  proximaCobranca DateTime? // next_payment_date enquanto está autorizada
  // Fim do período já pago. Preenchido quando a assinatura é cancelada ou pausada, para
  // o acesso valer até o dia em que a próxima cobrança aconteceria.
  validoAte       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Períodos de modo férias (histórico). Cada viagem é uma linha; `fim` null = férias
// ainda ligado. Guardar TODOS os períodos (em vez de uma única janela no User) é o
// que impede a ofensiva de quebrar retroativamente quando o modo é ligado de novo.
model FeriasPeriodo {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inicio     DateTime
  fim        DateTime? // null = período em aberto (modo férias ligado agora)
  // Concurso cuja ofensiva o período protege. null = período antigo, de antes da
  // ofensiva por trilha: vale para todos os concursos do usuário.
  concursoId String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([userId, concursoId])
}

// Sessão de estudo em andamento (uma por usuário). Guarda apenas a ORDEM dos IDs e
// o cursor: o conteúdo continua no frontend e as respostas são persistidas em Answer.
// Permite ao usuário sair no meio e retomar de onde parou ("Continuar estudando").
model SessaoAtiva {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contexto   Contexto @default(ESTUDO)
  questaoIds Int[] // ordem das questões da sessão
  cursor     Int      @default(0) // índice da questão atual
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Cada tentativa de resposta. Snapshots permitem estatística/sorteio sem o JSON.
model Answer {
  id                  String   @id @default(cuid())
  clientId            String?  @unique // id gerado no cliente p/ deduplicar reenvios (fila offline)
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concursoId          String? // concurso da resposta (multi-concurso). null = legado
  questaoId           Int
  moduloSnapshot      String // "I" (gerais) | "II" (específicos)
  materiaSnapshot     String
  assuntoSnapshot     String
  dificuldadeSnapshot String // facil | media | dificil
  origemSnapshot      String? // oficial | adaptada | gerada | autoral (null = resposta legada)
  provaSnapshot       String? // chave da prova de origem, quando havia
  alternativaMarcada  String
  acertou             Boolean
  tempoSegundos       Int?
  contexto            Contexto
  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, acertou, moduloSnapshot])
  @@index([userId, questaoId])
}

// Meta fixa por matéria do dia (rodízio de segunda a sexta; ver src/lib/metaMateria.ts).
// Guarda as 10 questões sorteadas PARA AQUELE DIA: a meta do dia não pode trocar de
// questão no meio do dia. Uma linha por usuário/concurso/dia.
model MetaMateriaDia {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concursoId String? // concurso da meta (multi-concurso). null = legado
  dia        DateTime // meia-noite local do dia (fuso do usuário), em UTC
  materia    String // rótulo do rodízio ("Legislação")
  questaoIds Int[] // as questões sorteadas, na ordem de estudo
  createdAt  DateTime @default(now())

  @@unique([userId, concursoId, dia])
  @@index([userId, dia])
}

// Anotação do usuário na questão: uma por questão por usuário.
model Nota {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concursoId String? // concurso da anotação (multi-concurso). null = legado
  questaoId  Int
  texto      String
  updatedAt  DateTime @updatedAt

  @@unique([userId, questaoId])
}

// "Marcar questão pra revisar depois": flag por questão por usuário.
model Marcada {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concursoId String? // concurso da marcação (multi-concurso). null = legado
  questaoId  Int
  createdAt  DateTime @default(now())

  @@unique([userId, questaoId])
}

// Refresh tokens persistidos (hash) para permitir logout/revogação.
// Código de 6 dígitos mandado por e-mail. finalidade "login" = segunda etapa do login
// (o cliente guarda o desafio, que amarra o código à tentativa de login); "ativar" =
// confirmação de que o e-mail recebe antes de ligar a verificação em duas etapas.
model CodigoEmail {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  finalidade  String
  desafioHash String   @unique
  codigoHash  String
  tentativas  Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Resumo público da Batalha Pokémon (time, insígnias, capturas) para o perfil do ranking.
// O jogo em si vive no localStorage do aparelho; o cliente publica este resumo quando o
// perfil muda. Sem linha = a pessoa nunca abriu a batalha.
model PokeVitrine {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dados     Json // ver VitrineSchema em src/modules/poke/poke.routes.ts
  updatedAt DateTime @updatedAt
}

// Jogo inteiro da Batalha Pokémon (perfil, partida em andamento e sprite do treinador),
// no formato do frontend (lib/poke/motor.ts). O servidor só guarda e devolve.
model PokeSave {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  perfil         Json?
  partida        Json?
  jogador        String?
  // Trilha em que a jornada compartilhada foi jogada por último. Entrar em OUTRA trilha
  // pergunta se a jornada continua ali ou recomeça (ver PokeSaveTrilha).
  ultimaTrilhaId String?
  updatedAt      DateTime @updatedAt
}

// Escolha da jornada numa trilha. separada=false: a trilha usa a jornada compartilhada
// (PokeSave). separada=true: a trilha tem a própria jornada, que começou do zero, em
// perfil/partida daqui. Sem linha: ainda não escolheu (pergunta ao entrar).
model PokeSaveTrilha {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trilhaId  String
  separada  Boolean  @default(false)
  perfil    Json?
  partida   Json?
  updatedAt DateTime @updatedAt

  @@id([userId, trilhaId])
}

// Cada PDF lido pela IA: é daqui que sai o saldo de páginas do mês.
model ImportacaoPdf {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trilhaId  String?
  paginas   Int
  questoes  Int // quantas a IA devolveu (antes da revisão do usuário)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Questão que também pertence a outra trilha além da dona (Questao.trilhaId). É assim que
// uma questão da Dataprev aparece na trilha de Banco de Dados sem virar duas linhas: a
// resposta, a nota e a marcação continuam apontando para o mesmo questaoId.
model QuestaoTrilha {
  questaoId Int
  questao   Questao  @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  trilhaId  String
  trilha    Trilha   @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  // Nome da matéria dentro desta trilha. null = usa Questao.materia. Existe porque na
  // Dataprev a questão é "Desenvolvimento de Software" e na trilha Python é outra coisa.
  materia   String?
  topico    String // item da ementa da trilha (relatório de cobertura)
  createdAt DateTime @default(now())

  @@id([questaoId, trilhaId])
  @@index([trilhaId])
}

// Exercício prático de código: o usuário escreve e o sandbox corre contra os testes.
model Exercicio {
  id            String   @id // slug, ex.: "py-soma-pares"
  trilhaId      String
  trilha        Trilha   @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  titulo        String
  enunciado     String
  linguagem     String // python | javascript | typescript | java | cpp | sql | shell
  // io = stdin → stdout; sql = consulta sobre seedSql; testes = o usuário escreve testes
  // que precisam pegar implementações com bug; shell = comandos sobre um repositório git.
  modo          String   @default("io")
  codigoInicial String   @default("")
  seedSql       String? // banco de partida (modo sql) ou script de preparo (modo shell)
  dificuldade   String // facil | media | dificil
  topico        String
  origem        String   @default("autoral")
  publicado     Boolean  @default(true)
  ordem         Int      @default(0)
  createdAt     DateTime @default(now())

  testes    TesteExercicio[]
  execucoes Execucao[]

  @@index([trilhaId, ordem])
}

// Caso de teste. Os ocultos NUNCA saem da API: o cliente só recebe passou/falhou deles,
// sem a entrada, a saída esperada nem o stdout produzido.
model TesteExercicio {
  id            String    @id @default(cuid())
  exercicioId   String
  exercicio     Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  ordem         Int       @default(0)
  oculto        Boolean   @default(false)
  nome          String    @default("")
  entrada       String    @default("") // stdin (io), ou o código-alvo no modo testes
  saidaEsperada String
  comparacao    String    @default("exata") // exata | linhas | conjunto

  @@index([exercicioId, ordem])
}

// Fila do sandbox. A API só insere a linha e lê o resultado; o worker (serviço separado)
// pega a próxima com FOR UPDATE SKIP LOCKED, roda num container efêmero e grava aqui.
// Também serve de rate limit (execuções por usuário no último minuto) e de prova de que
// uma questão de código foi executada (Questao.execucaoId, finalidade "verificacao").
model Execucao {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercicioId String?
  exercicio   Exercicio? @relation(fields: [exercicioId], references: [id], onDelete: SetNull)
  finalidade  String // exercicio | verificacao
  linguagem   String
  codigo      String
  hash        String // sha256 de linguagem + código: casa a verificação com a questão
  status      String     @default("fila") // fila | rodando | concluida | falhou
  // { compilacao, testes: [{ nome, oculto, passou, stdout?, stderr?, tempoMs }], ... }
  resultado   Json?
  createdAt   DateTime   @default(now())
  iniciadoEm  DateTime?
  concluidoEm DateTime?

  questoes Questao[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([hash])
}
