// Prisma schema: banco de questões.
// Regra central: o backend NUNCA guarda enunciado/alternativas/gabarito. Só o resultado
// da resposta com snapshots de modulo/materia/assunto/dificuldade, o que permite gerar
// estatística e priorizar erradas sem depender do JSON de questões.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Contexto {
  ESTUDO
  FLASH
  SIMULADO
  TOPICO
}

// Banco de questões (conteúdo). Compartilhado entre usuários (não é escopo por userId).
// A correção de acerto continua no frontend; o backend só guarda e serve o conteúdo.
model Questao {
  id           Int      @id // ID definido no lote (usado como questaoId em Answer)
  concursoId   String? // concurso ao qual a questão pertence (multi-concurso). null = legado
  modulo       String // "I" | "II"
  materia      String
  assunto      String
  dificuldade  String // facil | media | dificil
  textoBaseKey String? // chave em TextoBase (questões de inglês)
  enunciado    String
  codigo       String? // bloco de código opcional
  linguagem    String? // rótulo da linguagem do código
  alternativas Json // { "A": "...", "B": "...", ... }
  gabarito     String
  explicacao   String
  // Figuras da questão: [{ arquivo, legenda, posicao, dados }], com a imagem embutida
  // como data URI em `dados`. null/ausente na maioria das questões.
  imagens      Json?
  loteNome     String? // rótulo do lote (nome do arquivo importado); null p/ imports antigos
  // Procedência da questão: "oficial" (texto igual ao da prova), "adaptada" (baseada numa
  // prova, com texto alterado), "gerada" (criada como reforço a partir dos meus erros) ou
  // "autoral" (escrita sem prova de referência). Legado importado antes disso = "autoral".
  origem         String  @default("autoral")
  provaChave     String? // prova de onde veio (oficial/adaptada); null nas demais origens
  prova          Prova?  @relation(fields: [provaChave], references: [chave], onDelete: SetNull)
  numeroOriginal Int? // número que a questão tinha na prova de origem
  // Reforço: IDs das questões erradas que motivaram a geração desta. [] / null nas demais.
  geradaDe       Json?
  createdAt    DateTime @default(now()) // idêntico p/ toda questão de um mesmo import → chave do lote

  @@index([modulo, materia])
  @@index([createdAt])
  @@index([concursoId])
  @@index([origem])
  @@index([provaChave])
}

// Prova de concurso de onde uma ou mais questões vieram. Vive fora da Questao porque
// dezenas de questões compartilham a mesma prova (mesmo padrão de TextoBase).
model Prova {
  chave     String    @id // ex.: "FGV_TCE-TO_2022_ANALISTA-TI"
  banca     String
  orgao     String
  ano       Int
  cargo     String? // cargo/perfil da prova
  tipo      String? // caderno, quando a banca embaralha versões (FGV: "1", "2", "3")
  url       String? // PDF oficial
  createdAt DateTime  @default(now())
  questoes  Questao[]

  @@index([banca, ano])
}

// Concurso do usuário. O app é multi-concurso: cada concurso tem seu próprio conjunto de
// questões, respostas, anotações e caderno. Nenhum dado atravessa concursos.
model Concurso {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome       String // "Banco do Brasil"
  iniciais   String // "BB"
  banca      String // "CESGRANRIO"
  ano        Int
  cargo      String
  dataProva  DateTime
  metaDiaria Int      @default(30)
  arquivado  Boolean  @default(false)
  createdAt  DateTime @default(now())

  paginas PaginaCaderno[]
  postits PostIt[]

  @@index([userId])
}

// Página do Caderno (anotações tipo Notion), escopada por usuário + concurso + matéria.
model PaginaCaderno {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concursoId String
  concurso   Concurso @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  materia    String
  titulo     String   @default("")
  conteudo   String   @default("") // HTML saneado quando formato = "html"
  // "html" = conteúdo do editor rico; "texto" = páginas antigas, salvas como texto puro
  // (o cliente converte para parágrafos ao abrir e regrava já como html).
  formato    String   @default("html")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, concursoId])
}

// Post-it do mural (Home), arrastável, escopado por usuário + concurso.
model PostIt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concursoId String
  concurso   Concurso @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  x          Float    @default(0)
  y          Float    @default(0)
  texto      String   @default("")
  cor        String   @default("amber") // amber | sage | rose | slate
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, concursoId])
}

model TextoBase {
  chave String @id
  texto String
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  nome         String
  metaDiaria   Int       @default(70) // meta diária de questões (configurável no futuro)
  dataProva    DateTime? // data alvo da prova (configurável pelo usuário)
  feriasAtivo  Boolean   @default(false) // modo férias ligado: dias não quebram a ofensiva
  feriasDesde  DateTime? // instante em que o modo férias foi ligado (janela atual/última)
  feriasAte    DateTime? // instante em que foi desligado (null enquanto ativo)
  createdAt    DateTime  @default(now())

  answers        Answer[]
  notas          Nota[]
  marcadas       Marcada[]
  concursos      Concurso[]
  paginas        PaginaCaderno[]
  postits        PostIt[]
  feriasPeriodos FeriasPeriodo[]
  refreshTokens  RefreshToken[]
  sessaoAtiva    SessaoAtiva?
}

// Períodos de modo férias (histórico). Cada viagem é uma linha; `fim` null = férias
// ainda ligado. Guardar TODOS os períodos (em vez de uma única janela no User) é o
// que impede a ofensiva de quebrar retroativamente quando o modo é ligado de novo.
model FeriasPeriodo {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inicio    DateTime
  fim       DateTime? // null = período em aberto (modo férias ligado agora)
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Sessão de estudo em andamento (uma por usuário). Guarda apenas a ORDEM dos IDs e
// o cursor: o conteúdo continua no frontend e as respostas são persistidas em Answer.
// Permite ao usuário sair no meio e retomar de onde parou ("Continuar estudando").
model SessaoAtiva {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contexto   Contexto @default(ESTUDO)
  questaoIds Int[] // ordem das questões da sessão
  cursor     Int      @default(0) // índice da questão atual
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Cada tentativa de resposta. Snapshots permitem estatística/sorteio sem o JSON.
model Answer {
  id                  String   @id @default(cuid())
  clientId            String?  @unique // id gerado no cliente p/ deduplicar reenvios (fila offline)
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concursoId          String? // concurso da resposta (multi-concurso). null = legado
  questaoId           Int
  moduloSnapshot      String // "I" (gerais) | "II" (específicos)
  materiaSnapshot     String
  assuntoSnapshot     String
  dificuldadeSnapshot String // facil | media | dificil
  origemSnapshot      String? // oficial | adaptada | gerada | autoral (null = resposta legada)
  provaSnapshot       String? // chave da prova de origem, quando havia
  alternativaMarcada  String
  acertou             Boolean
  tempoSegundos       Int?
  contexto            Contexto
  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, acertou, moduloSnapshot])
  @@index([userId, questaoId])
}

// Anotação do usuário na questão: uma por questão por usuário.
model Nota {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concursoId String? // concurso da anotação (multi-concurso). null = legado
  questaoId  Int
  texto      String
  updatedAt  DateTime @updatedAt

  @@unique([userId, questaoId])
}

// "Marcar questão pra revisar depois": flag por questão por usuário.
model Marcada {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concursoId String? // concurso da marcação (multi-concurso). null = legado
  questaoId  Int
  createdAt  DateTime @default(now())

  @@unique([userId, questaoId])
}

// Refresh tokens persistidos (hash) para permitir logout/revogação.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
